[Unit]
Description=Neonvale dev server (Vite, http://0.0.0.0:19347)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/host/cybervalley

[Service]
Type=simple
User=ashley
Group=ashley
WorkingDirectory=/host/cybervalley
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/linuxbrew/.linuxbrew/bin/node /host/cybervalley/node_modules/vite/bin/vite.js --host 0.0.0.0 --port 19347 --strictPort
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
